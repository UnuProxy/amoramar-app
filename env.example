# ==========================================
# AMOR AMAR - Environment Variables Template
# ==========================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git!

# ==========================================
# APP MODE (web or backoffice)
# ==========================================
# For web (public website): web
# For backoffice (admin): backoffice
NEXT_PUBLIC_APP_MODE=backoffice



# Firebase Admin SDK (for server-side operations)
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"

# ==========================================
# STRIPE CONFIGURATION
# ==========================================
# Get these from Stripe Dashboard > Developers > API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# ==========================================
# EMAIL CONFIGURATION (Resend)
# ==========================================
#
RESEND_API_KEY=re_xxxxxxxxxxxxx
# Verified sender. Domain must be verified in Resend.
# Keep quotes in .env.local; do not type quotes when adding the value in Vercel UI.
RESEND_FROM_EMAIL="Amor Amar <info@amoramarbeauty.com>"
ENABLE_BOOKING_EMAILS=true

# ==========================================
# NEXTJS CONFIGURATION
# ==========================================
# Production URL (for web)
NEXT_PUBLIC_BASE_URL=https://amoramar.com

# Backoffice URL
NEXT_PUBLIC_BACKOFFICE_URL=https://admin.amoramar.com

# ==========================================
# WHATSAPP CLOUD API (Meta)
# ==========================================
META_ACCESS_TOKEN=EAA...
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=en_US
# Optional fixed location placeholder for WhatsApp templates
WHATSAPP_LOCATION_LABEL=Amor Amar
# Optional: used by GET /api/notifications/whatsapp/webhook verification challenge
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_random_secret

# Optional: protect cron endpoint /api/notifications/whatsapp/process
CRON_SECRET=replace_with_random_secret




